<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SMTPNG</AssemblyName>
    <RootNamespace>DummySmtp</RootNamespace>
    <Product>SMTPNG</Product>
    <Title>SMTPNG</Title>
    <Version>1.6.1</Version>
    <ApplicationIcon>Assets\SMTPNG.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\SMTPNG.ico" LogicalName="SMTPNG.ico" />
    <EmbeddedResource Include="README.md" LogicalName="SMTPNG.README.md" />
    <EmbeddedResource Include="Set-SMTPNGCertificateName.ps1" LogicalName="SMTPNG.Set-SMTPNGCertificateName.ps1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" NoWarn="NU1510" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WriteInstallationManifest" AfterTargets="Publish">
    <Exec Command="&quot;$(PublishDir)SMTPNG.exe&quot; --write-manifest &quot;$(PublishDir).&quot;" />
  </Target>
</Project>
